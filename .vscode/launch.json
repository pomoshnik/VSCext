{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Расширение: конфигуратор 1С (F5)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}/extension"
      ]
    },
    {
      "name": "Клиент 1С-мини (отладка)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-client",
      "program": "${workspaceFolder}/client/Client/bin/Debug/net10.0/Client.dll",
      "args": ["${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Публикатор (отладка)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-publisher",
      "program": "${workspaceFolder}/tools/Publisher/bin/Debug/net10.0/Publisher.dll",
      "args": ["metadata", "data/app.db"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    }
  ]
}
