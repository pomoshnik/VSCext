{
  "name": "onec-config-tree",
  "displayName": "Дерево конфигурации 1С",
  "description": "Дерево конфигурации в стиле 1С: хранение в JSON-файлах, модули бизнес-логики на C#, публикация в SQLite и клиент на Avalonia.",
  "version": "0.23.0",
  "publisher": "arena-tools",
  "license": "MIT",
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onecExplorer",
          "title": "Конфигуратор 1С",
          "icon": "media/activity.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "onecProperties",
          "title": "Свойства (1С)",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "onecExplorer": [
        {
          "id": "onecConfigTree",
          "name": "Конфигурация"
        }
      ],
      "onecProperties": [
        {
          "id": "onecProps",
          "name": "Свойства",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "onecTree.add",
        "title": "Добавить",
        "icon": "$(add)"
      },
      {
        "command": "onecTree.delete",
        "title": "Удалить",
        "icon": "$(trash)"
      },
      {
        "command": "onecTree.properties",
        "title": "Свойства",
        "icon": "$(settings-gear)"
      },
      {
        "command": "onecTree.rename",
        "title": "Переименовать",
        "icon": "$(edit)"
      },
      {
        "command": "onecTree.openModule",
        "title": "Открыть модуль объекта (C#)",
        "icon": "$(file-code)"
      },
      {
        "command": "onecTree.setType",
        "title": "Изменить тип значения"
      },
      {
        "command": "onecTree.publish",
        "title": "Опубликовать в SQLite",
        "icon": "$(database)"
      },
      {
        "command": "onecTree.init",
        "title": "1С: Инициализировать проект конфигурации"
      },
      {
        "command": "onecTree.refresh",
        "title": "Обновить",
        "icon": "$(refresh)"
      },
      {
        "command": "onecTree.publishDotnet",
        "title": "1С: Публикация через dotnet (резервный вариант)"
      },
      {
        "command": "onecTree.debug",
        "title": "Запустить клиент с отладкой",
        "icon": "$(debug-alt)"
      },
      {
        "command": "onecTree.openForm",
        "title": "Открыть форму (визуальный редактор)",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "onecTree.add",
          "when": "view == onecConfigTree",
          "group": "navigation@1"
        },
        {
          "command": "onecTree.delete",
          "when": "view == onecConfigTree",
          "group": "navigation@2"
        },
        {
          "command": "onecTree.properties",
          "when": "view == onecConfigTree",
          "group": "navigation@3"
        },
        {
          "command": "onecTree.publish",
          "when": "view == onecConfigTree",
          "group": "navigation@4"
        },
        {
          "command": "onecTree.debug",
          "when": "view == onecConfigTree",
          "group": "navigation@5"
        },
        {
          "command": "onecTree.refresh",
          "when": "view == onecConfigTree",
          "group": "navigation@6"
        },
        {
          "command": "onecTree.init",
          "when": "view == onecConfigTree",
          "group": "9_other@1"
        }
      ],
      "view/item/context": [
        {
          "command": "onecTree.openForm",
          "when": "view == onecConfigTree && viewItem == form",
          "group": "0_open@1"
        },
        {
          "command": "onecTree.add",
          "when": "view == onecConfigTree && viewItem =~ /^(root|class|object|objectM|folder|tabular)$/",
          "group": "inline@1"
        },
        {
          "command": "onecTree.openModule",
          "when": "view == onecConfigTree && viewItem == objectM",
          "group": "inline@2"
        },
        {
          "command": "onecTree.delete",
          "when": "view == onecConfigTree && viewItem =~ /^(object|objectM|leaf|tabular|form)$/",
          "group": "inline@3"
        },
        {
          "command": "onecTree.add",
          "when": "view == onecConfigTree && viewItem =~ /^(root|class|object|objectM|folder|tabular)$/",
          "group": "1_new@1"
        },
        {
          "command": "onecTree.openModule",
          "when": "view == onecConfigTree && viewItem == objectM",
          "group": "2_module@1"
        },
        {
          "command": "onecTree.setType",
          "when": "view == onecConfigTree && viewItem =~ /^(object|leaf)$/",
          "group": "2_module@2"
        },
        {
          "command": "onecTree.rename",
          "when": "view == onecConfigTree && viewItem =~ /^(root|object|objectM|leaf|tabular|form)$/",
          "group": "5_modify@1"
        },
        {
          "command": "onecTree.delete",
          "when": "view == onecConfigTree && viewItem =~ /^(object|objectM|leaf|tabular|form)$/",
          "group": "5_modify@2"
        },
        {
          "command": "onecTree.publish",
          "when": "view == onecConfigTree && viewItem == root",
          "group": "7_publish@1"
        },
        {
          "command": "onecTree.properties",
          "when": "view == onecConfigTree",
          "group": "9_props@1"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.26.0"
  },
  "dependencies": {
    "sql.js": "^1.10.3"
  }
}
